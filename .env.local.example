# Local environment configuration example — copy to .env.local and fill in.
# NEVER commit .env.local.

# ---- AI providers (at least one required) --------------------------------
# Groq: free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here
# Optional extra Groq keys (up to _5) for higher rate limits:
# GROQ_API_KEY_2=gsk_...
# Or a comma-separated list instead of individually-named keys:
# GROQ_API_KEYS=gsk_key1,gsk_key2

# Mistral: free key at https://console.mistral.ai (optional but recommended —
# the provider pool rotates across Groq + Mistral and fails over on 429s)
MISTRAL_API_KEY=your_mistral_key_here

# ---- Database (required) --------------------------------------------------
# Free Postgres at https://neon.tech — use the pooled connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Sessions (required) --------------------------------------------------
# Generate with: openssl rand -base64 48  (32+ chars required in production)
JWT_SECRET=replace-with-48-random-characters-minimum-32

# ---- Rate limiting (optional, recommended in production) ------------------
# Free Redis REST API at https://upstash.com — makes rate limits shared
# across all serverless instances. Without these, an in-memory limiter is used.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ---- App URL (optional) ---------------------------------------------------
# Public URL of the deployment, used for canonical links.
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ---- Contact form (optional) ------------------------------------------------
# Where contact/complaint form messages are delivered. While Resend is in
# sandbox mode (no verified domain), this must be your Resend account email.
# RESEND_API_KEY must also be set for the form to work.
# CONTACT_EMAIL=you@example.com

# ---- Image generation (optional) -------------------------------------------
# Google Gemini key — powers in-chat image generation ("draw a poster of the
# water cycle"). Free key at https://aistudio.google.com/apikey. When unset,
# image-style messages are simply answered as regular text chat.
# Optional model override (defaults to gemini-2.5-flash-image).
# NOTE: free-tier Gemini keys have no image quota — requests automatically
# fall back to the keyless free provider until billing is enabled.
# GEMINI_IMAGE_MODEL=

# ---- Image generation, Pollinations key (optional) --------------------------
# Pollen API key removes the 1-image/45s anonymous limit and the corner logo.
# Get one at https://enter.pollinations.ai (API keys → create).

# Optional: federated sign-in (Google/GitHub) and password reset via Firebase.
# Leave blank to keep the built-in email/password flow only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: contact form delivery.
RESEND_API_KEY=
CONTACT_EMAIL=
EMAIL_FROM=

# Optional: /admin panel access.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
