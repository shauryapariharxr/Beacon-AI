# Local environment configuration example — copy to .env.local and fill in.
# NEVER commit .env.local.

# ---- AI providers (at least one required) --------------------------------
# Groq: free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here
# Optional extra Groq keys (up to _5) for higher rate limits:
# GROQ_API_KEY_2=gsk_...
# Or a comma-separated list instead of individually-named keys:
# GROQ_API_KEYS=gsk_key1,gsk_key2

# Mistral: free key at https://console.mistral.ai
# Requests rotate across ALL configured providers (Groq + Mistral); if one
# is rate-limited, the other takes over automatically.
MISTRAL_API_KEY=your_mistral_key_here

# ---- Database (required) --------------------------------------------------
# Free Postgres at https://neon.tech — copy the connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Sessions (required in production) -----------------------------------
# 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Email verification (optional) ----------------------------------------
# Free key at https://resend.com. If set, signups receive a verification
# link and can't log in until they verify. If unset, accounts are verified
# immediately (handy for local dev).
# RESEND_API_KEY=re_...
# Who the email is sent from. For testing use the onboarding@resend.dev
# sandbox; for production verify your own domain in Resend.
# EMAIL_FROM="Beacon <verify@yourdomain.com>"
# Public URL used in verification links (set this in production):
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ---- Upstash Redis (optional, recommended in production) ------------------
# Free tier at https://upstash.com (Rest API, NOT the plain TCP connection).
# Makes rate limits shared across all serverless instances. Unset = limits
# are tracked in-memory per instance (fine for local dev).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
